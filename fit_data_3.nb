          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"-", "M"}]]}]], 
        SuperscriptBox["L", "4"]}]}], ",", 
      RowBox[{"{", 
       RowBox[{
       "c00", ",", "c01", ",", "c02", ",", "c10", ",", "c11", ",", "c12", ",",
         "c20", ",", "c21", ",", "c22", ",", "c30", ",", "c31", ",", "c32", 
        ",", "c40", ",", "c41", ",", "c42"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"M", ",", "L"}], "}"}], ",", 
      RowBox[{"MaxIterations", "\[Rule]", "1000000"}]}], "]"}], 
    "\[IndentingNewLine]", 
    RowBox[{"bigfit3", "[", 
     RowBox[{"{", 
      RowBox[{
      "\"\<RSquared\>\"", ",", "\"\<AdjustedRSquared\>\"", ",", 
