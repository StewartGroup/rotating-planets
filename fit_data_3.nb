Cell["\<\
Additional figure generation code for \[OpenCurlyDoubleQuote]Angular momenta \
and pressure relationships in rotating terrestrial planets\
\[CloseCurlyDoubleQuote]\
\>", "Subtitle",
 CellChangeTimes->{{3.996083093153329*^9, 3.9960831269686985`*^9}, {
  3.9960831613676233`*^9, 
  3.9960831760727515`*^9}},ExpressionUUID->"cbe628ed-2247-4270-901c-\
35467d19349a"],

Cell["\<\
Data to produce these figures is extracted from HERCULES runs and written to \
a file read by this notebook by either HERCULES_analysis.ipynb or \
Manuscript_figures.ipynb.\
\>", "Text",
 CellChangeTimes->{{3.9960831856282673`*^9, 
  3.9960832312715607`*^9}},ExpressionUUID->"0ae68535-4aac-4250-b06d-\
636fb7a7914b"],

